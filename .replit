# Replit config — serves the static design system so it can be previewed/assessed.
run = "python3 -m http.server 8080 --bind 0.0.0.0"
entrypoint = "index.html"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
run = ["sh", "-c", "python3 -m http.server 8080 --bind 0.0.0.0"]
deploymentTarget = "static"
publicDir = "."
